{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: build",
      "type": "shell",
      "command": "swift build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: test",
      "type": "shell",
      "command": "swift test",
      "group": "test",
      "problemMatcher": "$swiftc"
    },
    {
      "label": "macOS: package app",
      "type": "shell",
      "command": "./Scripts/build-macos.sh",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Native engines: test",
      "type": "shell",
      "command": "./Scripts/test-native.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Project: full verification",
      "type": "shell",
      "command": "./Scripts/check-project.sh --bundle",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
